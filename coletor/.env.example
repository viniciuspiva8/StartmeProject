# Copie para .env e preencha. NUNCA versione o .env nem o JSON de credencial.
GOOGLE_APPLICATION_CREDENTIALS=./credenciais.json
# Token exigido no header X-Scraper-Token para disparar POST /api/coleta.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCRAPER_TOKEN=
# Origens autorizadas no CORS, separadas por virgula.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
PORTAL_URL=https://www.ciadeestagios.com.br/vagas-de-estagio/
PORTAL_BASE=https://www.ciadeestagios.com.br
VAGA_TTL_DIAS=30
HTTP_TIMEOUT=20
LOG_LEVEL=INFO
