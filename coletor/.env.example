# Copie para .env e preencha. NUNCA versione o .env nem o JSON de credencial.
GOOGLE_APPLICATION_CREDENTIALS=./credenciais.json
# Token exigido no header X-Scraper-Token para disparar POST /api/coleta.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCRAPER_TOKEN=
# Origens autorizadas no CORS, separadas por virgula (sem barra final, sem "*").
# Vite dev=5173, Vite preview=4173, Live Server=5500. Em producao, so o dominio real.
# Se o Vite subir em outra porta (5174...), acrescente-a aqui.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500
VAGA_TTL_DIAS=30
# Cache em memoria de GET /api/vagas, em segundos (0 desliga). Poupa a cota do Firestore:
# sem cache, cada requisicao le a colecao inteira (cota gratuita: 50 mil leituras/dia).
VAGAS_CACHE_TTL=120
LOG_LEVEL=INFO

# --- SerpApi (Google Jobs): unica fonte de vagas ---------------------------
# Chave do painel da SerpApi. Vai na query string das chamadas, por isso o
# coletor redige qualquer api_key antes de logar. Nunca a coloque em codigo.
SERPAPI_KEY=
# Consultas e localizacoes separadas por ";". Cada combinacao = 1 busca por pagina.
# Use os nomes canonicos de https://serpapi.com/locations.json (sem acento).
SERPAPI_QUERIES=estágio desenvolvedor;vaga júnior TI
# Padrao: capital (cobre todas as zonas) + as 7 cidades do Grande ABC = 8 localidades.
SERPAPI_LOCALIZACOES=Sao Paulo,State of Sao Paulo,Brazil;Santo Andre,State of Sao Paulo,Brazil;Sao Bernardo do Campo,State of Sao Paulo,Brazil;Sao Caetano do Sul,State of Sao Paulo,Brazil;Diadema,State of Sao Paulo,Brazil;Maua,State of Sao Paulo,Brazil;Ribeirao Pires,State of Sao Paulo,Brazil;Rio Grande da Serra,State of Sao Paulo,Brazil
# Timeout (s) de cada busca. O Google Jobs leva ~7 s e as vezes bem mais; falhas de rede
# tem 1 nova tentativa e, se persistirem, so aquela busca e pulada.
SERPAPI_TIMEOUT=45
# Aceitar vagas remotas ("Qualquer lugar") alem de Sao Paulo e Grande ABC? Padrao: nao.
SERPAPI_ACEITAR_REMOTO=false
# Paginas por combinacao (10 resultados por pagina).
SERPAPI_MAX_PAGINAS=1
# Teto mensal de buscas. O plano gratuito permite 250; 240 deixa margem.
SERPAPI_LIMITE_MENSAL=240
# Teto de buscas por execucao do POST /api/coleta, qualquer que seja a configuracao acima.
# Padrao: 2 consultas x 8 localidades x 1 pagina = 16. Coleta DIARIA nao cabe na cota
# (16 x 30 = 480 > 240): rode no maximo 2 vezes por semana (~128 buscas/mes) ou menos.
SERPAPI_MAX_BUSCAS_EXEC=16

# --- Desenvolvimento local (sem Firebase real) -----------------------------
# Com FIRESTORE_EMULATOR_HOST definido, o coletor usa o emulador do Firestore
# com credencial anonima e nao precisa de credenciais.json. Em producao a linha
# deve ficar AUSENTE ou comentada (uma variavel vazia tambem confunde a biblioteca).
# O docker-compose.local.yml ja define isto para o ambiente local.
# FIRESTORE_EMULATOR_HOST=firestore:8080
# GOOGLE_CLOUD_PROJECT=startme-local

# ----------------------------------------------------------------------------
# Integração acadêmica (ADR-002, docs/ADOCAO-FSA.md). Tudo opcional: o padrão é o modo demonstração.
# Em produção, segredos vêm do Secret Manager, nunca deste arquivo.
# ----------------------------------------------------------------------------
# AUTH_MODE=demo                 # demo | http | oidc
# ACADEMICO_PROVIDER=arquivo     # arquivo | sql | http
# SIMULADO=true                  # false tira a faixa "ambiente simulado"
# SESSAO_SEGREDO=                # 32+ bytes aleatórios. Sem ele a sessão fica desligada.
# CPF_PEPPER=                    # 32+ bytes aleatórios (chave do hash do CPF)
# DEMO_CPF=000.000.000-00
# DEMO_SENHA=senha
# ACADEMICO_ARQUIVO=             # caminho do JSON de alunos (padrão: integracao/dados/alunos_ficticios.json)
# ACADEMICO_SQL_URL=             # postgresql+psycopg://usuario:senha@host:5432/banco (só leitura)
# ACADEMICO_SQL_CONSULTA=SELECT nome, curso, semestre, (situacao = 'ATIVO') AS ativo FROM vw_startme WHERE cpf = :cpf
# ACADEMICO_HTTP_URL=https://fsa.exemplo/alunos/{cpf}/vinculo
# ACADEMICO_HTTP_CABECALHOS={"X-API-Key":"..."}
# ACADEMICO_HTTP_MAPA={"nome":"Aluno.Nome","curso":"Matricula.Curso.Nome","semestre":"Matricula.PeriodoAtual","ativo":{"caminho":"Aluno.Situacao","em":["Matriculado"]}}
# ACADEMICO_CPF_FORMATO=digitos  # digitos | pontuado
# ACADEMICO_TIMEOUT=5
# AUTH_HTTP_URL=https://fsa.exemplo/login   # só AUTH_MODE=http
# OIDC_ISSUER=https://idp.fsa.exemplo
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://startme.exemplo/api/auth/oidc/retorno
# OIDC_CPF_CLAIM=cpf
# FRONT_URL=https://startme.exemplo
# TERMO_VERSAO=2026-10
# SERPAPI_LIMITE_MENSAL=240
# AMBIENTE=local                 # só desenvolvimento: cookie sem Secure e http permitido
#
# MODO DE APRESENTAÇÃO (trava de entrega). Sem esta variável (ou com valor diferente de "true"),
# o serviço só sobe com AUTH_MODE=oidc (ou http) e ACADEMICO_PROVIDER=sql (ou http).
# Para apresentar com alunos fictícios, defina MODO_DEMONSTRACAO=true.
# Para a entrega, remova esta linha: é a única mudança necessária para sair do modo apresentação.
# MODO_DEMONSTRACAO=true
