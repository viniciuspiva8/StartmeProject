rules_version = '2';

// Regras do Firestore do StartMe: NEGAR TUDO para clientes.
//
// Quem le e escreve e so o backend (coletor), com a conta de servico, que usa o Admin SDK e
// ignora estas regras. Nenhum navegador ou aplicativo deve falar direto com o banco: as vagas
// chegam ao frontend por GET /api/vagas, com cache. Assim, uma chave publica do Firebase
// (se um dia existir no front) nao abre o banco, e a cota gratuita nao e consumida por terceiros.
//
// Como aplicar: console do Firebase -> Firestore Database -> Regras -> colar este conteudo -> Publicar.
// (Ou, com a Firebase CLI: firebase deploy --only firestore:rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
